# =============================================================================
# ProfPay — production .env
#   cp .env.production.example .env  &&  nano .env
#
# Переменные читает docker-compose.prod.yml и передаёт контейнеру backend.
# Отдельного .env внутри backend/ нет — настройки берутся из окружения.
# =============================================================================

# ---- Первый администратор (создаётся при первом запуске) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=ЗАМЕНИ@example.com
ADMIN_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ---- PostgreSQL ----
POSTGRES_USER=profpay_user
POSTGRES_PASSWORD=ЗАМЕНИ_НА_НАДЁЖНЫЙ_ПАРОЛЬ_БД
POSTGRES_DB=profpay_db

# ---- Подпись сессий ----
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Минимум 32 символа, иначе приложение не стартует (RFC 7518 для HMAC-SHA256).
# Смена ключа на работающей системе разлогинит всех — данные при этом целы.
SECRET_KEY=ЗАМЕНИ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ

# ---- Шифрование персональных данных ----
# Сгенерировать:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ВНИМАНИЕ: этим ключом зашифрованы контакты, даты рождения и примечания.
# Потеряете его — эти поля не прочитает никто, даже из дампа базы.
# ФИО, группы, курсы и суммы хранятся открытыми и переживут потерю ключа.
# Сохраните копию в менеджере паролей, отдельно от резервных копий базы.
ENCRYPTION_KEY=ЗАМЕНИ_НА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ_FERNET

# ---- Сессии ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Защита входа ----
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Порт на хосте ----
# На сервере несколько сайтов. Если 8020 занят — поменяйте здесь
# и в конфиге nginx для profpay.site.
PROFPAY_PORT=8020

# ---- Восстановление пароля по почте (необязательно) ----
# Без SMTP восстановление недоступно: пароль задаёт администратор
# в разделе «Пользователи».
PUBLIC_URL=https://profpay.site
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Отладка ----
# true открывает /api/docs. В проде только false.
DEBUG=false
